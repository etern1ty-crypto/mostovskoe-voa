---
interface Props {
  value: string;
  label: string;
  description?: string;
}
const { value, label, description } = Astro.props;
---

<div
  class="flex flex-col gap-1 p-6 rounded-2xl bg-white/[0.04] backdrop-blur border border-white/10"
>
  <span class="font-display text-4xl md:text-5xl font-bold text-accent-300 leading-none">
    {value}
  </span>
  <span class="font-semibold text-white text-sm md:text-base mt-2">{label}</span>
  {description && <span class="text-xs text-white/60">{description}</span>}
</div>
