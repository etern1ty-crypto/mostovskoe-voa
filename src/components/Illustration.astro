---
// Inline SVG illustrations — one per scene. No external assets.
// All illustrations are flat-vector, brand-colored, designed to feel
// hand-drawn but technical (driving school theme).
type Variant =
  | "hero"
  | "moto"
  | "car"
  | "truck"
  | "classroom"
  | "track"
  | "exam"
  | "wheel"
  | "map"
  | "garage";
interface Props {
  variant: Variant;
  class?: string;
  ariaLabel?: string;
}
const { variant, class: className = "", ariaLabel } = Astro.props;
---

<div
  class={`relative w-full aspect-[4/3] overflow-hidden rounded-2xl ${className}`}
  role="img"
  aria-label={ariaLabel ?? variant}
>
  {
    variant === "hero" && (
      <svg
        viewBox="0 0 800 600"
        xmlns="http://www.w3.org/2000/svg"
        class="absolute inset-0 w-full h-full"
        preserveAspectRatio="xMidYMid slice"
      >
        <defs>
          <linearGradient id="hero-sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#0c2c5c" />
            <stop offset="0.55" stop-color="#163774" />
            <stop offset="1" stop-color="#2a5db4" />
          </linearGradient>
          <linearGradient id="hero-asphalt" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#1f2937" />
            <stop offset="1" stop-color="#0f172a" />
          </linearGradient>
          <radialGradient id="hero-sun" cx="0.8" cy="0.15" r="0.5">
            <stop offset="0" stop-color="#fbc54e" stop-opacity="0.9" />
            <stop offset="0.6" stop-color="#fbc54e" stop-opacity="0.2" />
            <stop offset="1" stop-color="#fbc54e" stop-opacity="0" />
          </radialGradient>
          <linearGradient id="hero-car" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#fef3c7" />
            <stop offset="1" stop-color="#f59e0b" />
          </linearGradient>
        </defs>
        <rect width="800" height="600" fill="url(#hero-sky)" />
        <circle cx="640" cy="120" r="160" fill="url(#hero-sun)" />
        {/* distant mountains */}
        <path
          d="M0 380 L120 320 L200 360 L300 290 L400 350 L520 280 L640 340 L800 300 L800 420 L0 420 Z"
          fill="#1c4795"
          opacity="0.6"
        />
        <path
          d="M0 420 L80 380 L200 405 L320 360 L440 400 L560 370 L680 390 L800 360 L800 460 L0 460 Z"
          fill="#0f2755"
          opacity="0.85"
        />
        {/* asphalt */}
        <path
          d="M0 460 L800 460 L800 600 L0 600 Z"
          fill="url(#hero-asphalt)"
        />
        {/* perspective road */}
        <path
          d="M280 460 L520 460 L640 600 L160 600 Z"
          fill="#111827"
        />
        {/* lane markings */}
        <g class="car-drive" opacity="0.95">
          <rect x="385" y="475" width="30" height="6" rx="2" fill="#fbc54e" />
        </g>
        <rect x="395" y="510" width="40" height="8" rx="2" fill="#fbc54e" />
        <rect x="390" y="555" width="60" height="10" rx="3" fill="#fbc54e" />
        {/* roadside posts */}
        <g fill="#ffffff" opacity="0.8">
          <rect x="160" y="450" width="4" height="22" rx="1" />
          <rect x="220" y="455" width="3.5" height="18" rx="1" />
          <rect x="640" y="450" width="4" height="22" rx="1" />
          <rect x="580" y="455" width="3.5" height="18" rx="1" />
        </g>
        {/* foreground car (3/4 view, stylized) */}
        <g transform="translate(310 470)">
          <rect
            x="0"
            y="40"
            width="200"
            height="44"
            rx="14"
            fill="url(#hero-car)"
          />
          <path
            d="M30 40 C 50 18, 150 18, 170 40 Z"
            fill="#fef3c7"
            opacity="0.95"
          />
          <rect
            x="40"
            y="22"
            width="120"
            height="22"
            rx="6"
            fill="#0c2c5c"
            opacity="0.85"
          />
          <rect x="50" y="26" width="50" height="14" rx="2" fill="#7ea2dd" />
          <rect
            x="105"
            y="26"
            width="50"
            height="14"
            rx="2"
            fill="#7ea2dd"
          />
          {/* headlight glow */}
          <circle cx="190" cy="62" r="6" fill="#fff8e6" />
          <circle cx="190" cy="62" r="14" fill="#fff8e6" opacity="0.3" />
          {/* wheels */}
          <circle cx="50" cy="86" r="13" fill="#0b1220" />
          <circle cx="50" cy="86" r="5" fill="#475569" />
          <circle cx="150" cy="86" r="13" fill="#0b1220" />
          <circle cx="150" cy="86" r="5" fill="#475569" />
        </g>
        {/* stars / sparks in sky */}
        <g fill="#fff" opacity="0.7">
          <circle cx="100" cy="60" r="1.4" />
          <circle cx="180" cy="100" r="1" />
          <circle cx="260" cy="50" r="1.3" />
          <circle cx="360" cy="90" r="1" />
          <circle cx="500" cy="60" r="1.2" />
        </g>
      </svg>
    )
  }

  {
    variant === "moto" && (
      <svg
        viewBox="0 0 400 300"
        xmlns="http://www.w3.org/2000/svg"
        class="absolute inset-0 w-full h-full"
      >
        <defs>
          <linearGradient id="m-bg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#0c2c5c" />
            <stop offset="1" stop-color="#1c4795" />
          </linearGradient>
        </defs>
        <rect width="400" height="300" rx="16" fill="url(#m-bg)" />
        <g opacity="0.18" fill="#fff">
          <circle cx="50" cy="50" r="1.5" />
          <circle cx="350" cy="40" r="1" />
          <circle cx="120" cy="80" r="1" />
        </g>
        {/* road */}
        <path d="M0 230 L400 230 L400 300 L0 300 Z" fill="#0f172a" />
        <rect x="180" y="258" width="40" height="6" rx="2" fill="#fbc54e" />
        <rect x="80" y="258" width="40" height="6" rx="2" fill="#fbc54e" opacity="0.6" />
        <rect x="280" y="258" width="40" height="6" rx="2" fill="#fbc54e" opacity="0.6" />
        {/* moto */}
        <g transform="translate(110 130)">
          {/* rear wheel */}
          <circle cx="30" cy="100" r="30" fill="#0b1220" stroke="#475569" stroke-width="2" />
          <circle cx="30" cy="100" r="14" fill="none" stroke="#94a3b8" stroke-width="2" />
          {/* front wheel */}
          <circle cx="170" cy="100" r="30" fill="#0b1220" stroke="#475569" stroke-width="2" />
          <circle cx="170" cy="100" r="14" fill="none" stroke="#94a3b8" stroke-width="2" />
          {/* body */}
          <path
            d="M40 90 C 50 50, 120 30, 160 90"
            stroke="#f59e0b"
            stroke-width="14"
            fill="none"
            stroke-linecap="round"
          />
          <path
            d="M55 95 L 110 70 L 150 75 L 170 95"
            stroke="#fbc54e"
            stroke-width="10"
            fill="none"
            stroke-linecap="round"
          />
          {/* headlight */}
          <circle cx="172" cy="62" r="10" fill="#fff8e6" />
          <circle cx="172" cy="62" r="18" fill="#fff8e6" opacity="0.25" />
          {/* handlebar */}
          <path
            d="M150 55 L 180 35"
            stroke="#94a3b8"
            stroke-width="4"
            stroke-linecap="round"
          />
          {/* seat */}
          <path
            d="M50 75 L 110 60"
            stroke="#0f172a"
            stroke-width="10"
            stroke-linecap="round"
          />
        </g>
      </svg>
    )
  }

  {
    variant === "car" && (
      <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 w-full h-full">
        <defs>
          <linearGradient id="c-bg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#0c2c5c" />
            <stop offset="1" stop-color="#163774" />
          </linearGradient>
          <linearGradient id="c-body" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffdc85" />
            <stop offset="1" stop-color="#f59e0b" />
          </linearGradient>
        </defs>
        <rect width="400" height="300" rx="16" fill="url(#c-bg)" />
        <g opacity="0.15" fill="#fff">
          <circle cx="40" cy="40" r="1" />
          <circle cx="80" cy="60" r="1" />
          <circle cx="360" cy="40" r="1" />
          <circle cx="320" cy="80" r="1" />
        </g>
        <path d="M0 230 L400 230 L400 300 L0 300 Z" fill="#0f172a" />
        <rect x="40" y="258" width="60" height="8" rx="2" fill="#fbc54e" opacity="0.7" />
        <rect x="170" y="258" width="60" height="8" rx="2" fill="#fbc54e" />
        <rect x="300" y="258" width="60" height="8" rx="2" fill="#fbc54e" opacity="0.7" />
        {/* car */}
        <g transform="translate(70 100)">
          <rect x="0" y="60" width="260" height="50" rx="18" fill="url(#c-body)" />
          <path d="M30 60 C 60 16, 200 16, 230 60 Z" fill="#fef3c7" />
          <rect x="50" y="28" width="160" height="34" rx="6" fill="#0c2c5c" opacity="0.85" />
          <line x1="130" y1="28" x2="130" y2="62" stroke="#0c2c5c" stroke-width="6" />
          <rect x="58" y="34" width="60" height="22" rx="3" fill="#7ea2dd" />
          <rect x="142" y="34" width="60" height="22" rx="3" fill="#7ea2dd" />
          {/* lights */}
          <circle cx="248" cy="85" r="7" fill="#fff8e6" />
          <circle cx="248" cy="85" r="14" fill="#fff8e6" opacity="0.3" />
          <circle cx="12" cy="85" r="6" fill="#dc2626" />
          {/* wheels */}
          <circle cx="60" cy="115" r="16" fill="#0b1220" />
          <circle cx="60" cy="115" r="6" fill="#475569" />
          <circle cx="200" cy="115" r="16" fill="#0b1220" />
          <circle cx="200" cy="115" r="6" fill="#475569" />
          {/* L sign — учебная */}
          <g transform="translate(120 -10)">
            <rect x="0" y="0" width="26" height="26" rx="4" fill="#fff" />
            <text
              x="13"
              y="20"
              text-anchor="middle"
              font-family="Manrope, sans-serif"
              font-weight="800"
              font-size="20"
              fill="#dc2626"
            >U</text>
          </g>
        </g>
      </svg>
    )
  }

  {
    variant === "truck" && (
      <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 w-full h-full">
        <defs>
          <linearGradient id="t-bg" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#163774" />
            <stop offset="1" stop-color="#0c2c5c" />
          </linearGradient>
        </defs>
        <rect width="400" height="300" rx="16" fill="url(#t-bg)" />
        <path d="M0 230 L400 230 L400 300 L0 300 Z" fill="#0f172a" />
        <rect x="100" y="258" width="60" height="8" rx="2" fill="#fbc54e" />
        <rect x="230" y="258" width="60" height="8" rx="2" fill="#fbc54e" opacity="0.7" />
        {/* truck */}
        <g transform="translate(40 110)">
          {/* trailer */}
          <rect x="0" y="0" width="180" height="100" rx="6" fill="#fef3c7" />
          <rect x="6" y="6" width="80" height="88" rx="2" fill="#fff" opacity="0.5" />
          <rect x="92" y="6" width="80" height="88" rx="2" fill="#fff" opacity="0.5" />
          {/* cab */}
          <path d="M180 30 L 240 30 L 250 60 L 250 100 L 180 100 Z" fill="#f59e0b" />
          <rect x="195" y="40" width="48" height="32" rx="4" fill="#0c2c5c" opacity="0.85" />
          <rect x="200" y="44" width="38" height="24" rx="2" fill="#7ea2dd" />
          {/* headlight */}
          <circle cx="245" cy="84" r="5" fill="#fff8e6" />
          {/* wheels */}
          <circle cx="34" cy="110" r="16" fill="#0b1220" />
          <circle cx="34" cy="110" r="5" fill="#475569" />
          <circle cx="120" cy="110" r="16" fill="#0b1220" />
          <circle cx="120" cy="110" r="5" fill="#475569" />
          <circle cx="220" cy="110" r="16" fill="#0b1220" />
          <circle cx="220" cy="110" r="5" fill="#475569" />
        </g>
      </svg>
    )
  }

  {
    variant === "classroom" && (
      <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 w-full h-full">
        <defs>
          <linearGradient id="cr-bg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#eef3fb" />
            <stop offset="1" stop-color="#d8e3f5" />
          </linearGradient>
        </defs>
        <rect width="400" height="300" rx="16" fill="url(#cr-bg)" />
        {/* blackboard */}
        <rect x="60" y="40" width="280" height="140" rx="6" fill="#0c2c5c" />
        <rect x="70" y="50" width="260" height="120" rx="3" fill="#163774" />
        {/* sign on board: правила */}
        <g fill="#fbc54e">
          <rect x="92" y="76" width="80" height="10" rx="2" />
          <rect x="92" y="96" width="160" height="6" rx="2" opacity="0.7" />
          <rect x="92" y="110" width="120" height="6" rx="2" opacity="0.6" />
          <rect x="92" y="124" width="140" height="6" rx="2" opacity="0.6" />
        </g>
        {/* triangular sign */}
        <g transform="translate(260 80)">
          <polygon points="30,0 60,52 0,52" fill="#fbc54e" stroke="#dc2626" stroke-width="4" />
          <text x="30" y="40" text-anchor="middle" font-family="Manrope" font-weight="800" font-size="22" fill="#0c2c5c">!</text>
        </g>
        {/* desks */}
        <g fill="#0c2c5c">
          <rect x="60" y="210" width="80" height="14" rx="3" />
          <rect x="74" y="224" width="6" height="40" />
          <rect x="118" y="224" width="6" height="40" />
          <rect x="160" y="210" width="80" height="14" rx="3" />
          <rect x="174" y="224" width="6" height="40" />
          <rect x="218" y="224" width="6" height="40" />
          <rect x="260" y="210" width="80" height="14" rx="3" />
          <rect x="274" y="224" width="6" height="40" />
          <rect x="318" y="224" width="6" height="40" />
        </g>
        {/* chairs as dots */}
        <g fill="#1c4795" opacity="0.6">
          <circle cx="100" cy="200" r="6" />
          <circle cx="200" cy="200" r="6" />
          <circle cx="300" cy="200" r="6" />
        </g>
      </svg>
    )
  }

  {
    variant === "track" && (
      <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 w-full h-full">
        <rect width="400" height="300" rx="16" fill="#0f172a" />
        {/* asphalt area */}
        <rect x="20" y="20" width="360" height="260" rx="12" fill="#1f2937" />
        {/* track outline */}
        <rect x="40" y="50" width="320" height="200" rx="80" fill="none" stroke="#fbc54e" stroke-width="3" stroke-dasharray="8 8" />
        {/* cones */}
        <g fill="#f59e0b">
          <polygon points="100,140 92,166 108,166" />
          <polygon points="180,140 172,166 188,166" />
          <polygon points="260,140 252,166 268,166" />
        </g>
        {/* car on track */}
        <g transform="translate(140 80)">
          <rect x="0" y="10" width="50" height="14" rx="6" fill="#fbc54e" />
          <circle cx="10" cy="26" r="5" fill="#0b1220" />
          <circle cx="40" cy="26" r="5" fill="#0b1220" />
        </g>
        {/* stripes for parking */}
        <g stroke="#fbc54e" stroke-width="2" opacity="0.9">
          <line x1="60" y1="220" x2="60" y2="240" />
          <line x1="85" y1="220" x2="85" y2="240" />
          <line x1="110" y1="220" x2="110" y2="240" />
          <line x1="135" y1="220" x2="135" y2="240" />
        </g>
      </svg>
    )
  }

  {
    variant === "exam" && (
      <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 w-full h-full">
        <rect width="400" height="300" rx="16" fill="#eef3fb" />
        {/* paper */}
        <g transform="translate(110 50)">
          <rect width="180" height="220" rx="6" fill="#fff" stroke="#cbd5e1" />
          <rect x="14" y="20" width="120" height="10" rx="2" fill="#0c2c5c" />
          <g fill="#94a3b8">
            <rect x="14" y="50" width="150" height="6" rx="2" />
            <rect x="14" y="70" width="120" height="6" rx="2" />
            <rect x="14" y="90" width="140" height="6" rx="2" />
            <rect x="14" y="120" width="150" height="6" rx="2" />
            <rect x="14" y="140" width="110" height="6" rx="2" />
            <rect x="14" y="170" width="100" height="6" rx="2" />
          </g>
          {/* check */}
          <circle cx="150" cy="190" r="20" fill="#16a34a" />
          <path d="M141 191 L 148 198 L 161 184" stroke="#fff" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </g>
        {/* pencil */}
        <g transform="rotate(28 60 220) translate(60 220)">
          <rect x="0" y="0" width="80" height="14" rx="3" fill="#f59e0b" />
          <polygon points="80,0 96,7 80,14" fill="#fef3c7" />
          <rect x="-10" y="0" width="10" height="14" fill="#dc2626" />
        </g>
      </svg>
    )
  }

  {
    variant === "wheel" && (
      <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 w-full h-full">
        <rect width="400" height="300" rx="16" fill="#0c2c5c" />
        <g transform="translate(200 150)" class="spin-slow">
          <circle r="100" fill="none" stroke="#f59e0b" stroke-width="10" />
          <circle r="70" fill="none" stroke="#fbc54e" stroke-width="3" stroke-dasharray="6 6" />
          <circle r="20" fill="#fbc54e" />
          <rect x="-90" y="-4" width="180" height="8" rx="4" fill="#f59e0b" />
          <rect x="-4" y="-90" width="8" height="180" rx="4" fill="#f59e0b" />
        </g>
      </svg>
    )
  }

  {
    variant === "map" && (
      <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 w-full h-full">
        <rect width="400" height="300" rx="16" fill="#eef3fb" />
        {/* grid */}
        <g stroke="#d8e3f5" stroke-width="1">
          <line x1="0" y1="60" x2="400" y2="60" />
          <line x1="0" y1="120" x2="400" y2="120" />
          <line x1="0" y1="180" x2="400" y2="180" />
          <line x1="0" y1="240" x2="400" y2="240" />
          <line x1="80" y1="0" x2="80" y2="300" />
          <line x1="160" y1="0" x2="160" y2="300" />
          <line x1="240" y1="0" x2="240" y2="300" />
          <line x1="320" y1="0" x2="320" y2="300" />
        </g>
        {/* route */}
        <path
          d="M40 240 C 100 180, 200 220, 240 140 S 340 80, 360 60"
          stroke="#f59e0b"
          stroke-width="5"
          fill="none"
          stroke-linecap="round"
          stroke-dasharray="10 8"
        />
        {/* pin */}
        <g transform="translate(354 50)">
          <circle r="14" fill="#dc2626" />
          <circle r="5" fill="#fff" />
        </g>
        <g transform="translate(40 240)">
          <circle r="10" fill="#0c2c5c" />
          <circle r="4" fill="#fbc54e" />
        </g>
      </svg>
    )
  }

  {
    variant === "garage" && (
      <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 w-full h-full">
        <rect width="400" height="300" rx="16" fill="#163774" />
        {/* building */}
        <rect x="40" y="80" width="320" height="160" fill="#0c2c5c" />
        <rect x="40" y="60" width="320" height="20" fill="#fbc54e" />
        {/* doors */}
        <g fill="#1f2937">
          <rect x="60" y="120" width="80" height="120" rx="6" />
          <rect x="160" y="120" width="80" height="120" rx="6" />
          <rect x="260" y="120" width="80" height="120" rx="6" />
        </g>
        {/* doors handles / windows */}
        <g fill="#7ea2dd">
          <rect x="68" y="130" width="64" height="20" rx="3" />
          <rect x="168" y="130" width="64" height="20" rx="3" />
          <rect x="268" y="130" width="64" height="20" rx="3" />
        </g>
        {/* sign */}
        <g transform="translate(180 35)">
          <rect width="40" height="22" rx="3" fill="#fff" />
          <text x="20" y="17" text-anchor="middle" font-family="Manrope" font-weight="800" font-size="14" fill="#0c2c5c">ВОА</text>
        </g>
        {/* ground */}
        <rect x="0" y="240" width="400" height="60" fill="#0f172a" />
        <rect x="60" y="252" width="60" height="6" fill="#fbc54e" />
        <rect x="200" y="252" width="60" height="6" fill="#fbc54e" />
      </svg>
    )
  }
</div>
