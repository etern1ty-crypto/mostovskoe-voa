---
interface Props {
  caption: string;
  label?: string;
  ratio?: "16/9" | "4/3" | "1/1" | "3/2" | "21/9";
  class?: string;
}

const {
  caption,
  label = "Фото будет здесь",
  ratio = "4/3",
  class: className = "",
} = Astro.props;
---

<!-- TODO: replace placeholder with real photo -->
<div
  class={`placeholder-photo ${className}`}
  style={`aspect-ratio: ${ratio};`}
  role="img"
  aria-label={`${label}: ${caption}`}
>
  <div>
    <div class="placeholder-label">{label}</div>
    <div class="placeholder-caption">{caption}</div>
  </div>
</div>
