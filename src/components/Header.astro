---
import { navigation, site } from "../data/site";
import Icon from "./Icon.astro";

const pathname = new URL(Astro.request.url).pathname;
function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<header class="sticky top-0 z-40 backdrop-blur bg-white/90 border-b border-[var(--color-ink-100)]">
  <div class="container-page flex items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-3 group" aria-label="На главную">
      <span
        class="grid place-items-center size-11 rounded-full bg-brand-900 text-white font-bold text-lg transition-transform group-hover:scale-105"
        aria-hidden="true"
      >
        В
      </span>
      <span class="flex flex-col leading-tight">
        <span class="font-display font-bold text-brand-900 text-base md:text-lg">
          {site.name}
        </span>
        <span class="text-xs text-ink-500 hidden sm:inline">
          Автошкола · {site.founded} год
        </span>
      </span>
    </a>

    <nav aria-label="Главная навигация" class="hidden 2xl:flex items-center gap-0.5">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class:list={[
              "px-3 py-2 rounded-full text-sm font-medium transition-colors whitespace-nowrap",
              isActive(item.href)
                ? "bg-brand-900 text-white"
                : "text-ink-700 hover:text-brand-900 hover:bg-brand-50",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden md:flex items-center gap-3">
      <a
        href={`tel:${site.phones[0].replace(/[^+\d]/g, "")}`}
        class="hidden 2xl:flex items-center gap-2 text-sm font-semibold text-brand-900 hover:text-accent-500 whitespace-nowrap"
      >
        <Icon name="phone" size={18} class="text-accent-500" />
        {site.phones[0]}
      </a>
      <a href="/contacts/#signup" class="btn btn-primary text-sm whitespace-nowrap">
        Записаться
        <Icon name="arrow-right" size={16} />
      </a>
    </div>

    <button
      type="button"
      data-mobile-menu-toggle
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="2xl:hidden inline-flex items-center justify-center size-11 rounded-full border border-ink-300 text-brand-900 hover:bg-ink-50"
    >
      <span class="sr-only">Открыть меню</span>
      <Icon name="menu" size={22} class="block menu-icon" />
      <Icon name="close" size={22} class="hidden close-icon" />
    </button>
  </div>

  <div
    id="mobile-menu"
    data-mobile-menu
    class="hidden 2xl:hidden border-t border-ink-100 bg-white"
  >
    <nav aria-label="Мобильная навигация" class="container-page py-4 grid gap-1">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class:list={[
              "flex items-center justify-between px-3 py-3 rounded-xl text-base font-medium transition-colors",
              isActive(item.href)
                ? "bg-brand-900 text-white"
                : "text-ink-700 hover:bg-brand-50 hover:text-brand-900",
            ]}
          >
            <span>{item.label}</span>
            <Icon name="arrow-right" size={18} class="opacity-60" />
          </a>
        ))
      }
      <div class="flex flex-col gap-2 pt-3 mt-2 border-t border-ink-100">
        <a
          href={`tel:${site.phones[0].replace(/[^+\d]/g, "")}`}
          class="btn btn-ghost text-sm"
        >
          <Icon name="phone" size={16} />
          {site.phones[0]}
        </a>
        <a href="/contacts/#signup" class="btn btn-primary text-sm">
          Записаться на обучение
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-mobile-menu-toggle]",
  );
  const menu = document.querySelector<HTMLDivElement>("[data-mobile-menu]");
  const menuIcon = toggle?.querySelector(".menu-icon");
  const closeIcon = toggle?.querySelector(".close-icon");

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const isOpen = menu.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(isOpen));
      menuIcon?.classList.toggle("hidden", isOpen);
      menuIcon?.classList.toggle("block", !isOpen);
      closeIcon?.classList.toggle("hidden", !isOpen);
      closeIcon?.classList.toggle("block", isOpen);
    });
  }
</script>
