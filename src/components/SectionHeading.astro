---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  level?: 1 | 2 | 3;
}

const {
  eyebrow,
  title,
  description,
  align = "left",
  level = 2,
} = Astro.props;
const Tag = `h${level}` as "h1" | "h2" | "h3";
---

<div
  class:list={[
    "flex flex-col gap-3 max-w-3xl",
    align === "center" && "items-center text-center mx-auto",
  ]}
>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <Tag
    class:list={[
      "font-display font-bold text-balance text-brand-950",
      level === 1
        ? "text-4xl md:text-5xl lg:text-6xl leading-[1.05]"
        : level === 2
          ? "text-3xl md:text-4xl lg:text-5xl leading-[1.1]"
          : "text-2xl md:text-3xl leading-tight",
    ]}
  >
    {title}
  </Tag>
  {
    description && (
      <p class="text-base md:text-lg text-ink-700 text-pretty leading-relaxed">
        {description}
      </p>
    )
  }
</div>
