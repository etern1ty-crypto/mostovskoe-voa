---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { categories } from "../../data/categories";

function iconFor(slug: string) {
  if (slug === "a") return "motorcycle" as const;
  if (slug.startsWith("c") || slug.includes("d")) return "truck" as const;
  return "car" as const;
}
---

<Layout
  title="Категории и курсы"
  pageTitle="Категории и курсы обучения"
  description="Полные программы профессиональной подготовки водителей и переподготовка с одной категории на другую. Часы, длительность, экзамены."
>
  <section class="section">
    <div class="container-page space-y-10">
      <SectionHeading
        eyebrow="Что вы получите"
        title="Профессиональная подготовка и переподготовка"
        description="Каждая программа включает теорию (ПДД, устройство, безопасность, первую помощь), практику на площадке и в городе, внутренний и государственный экзамены."
      />

      <div class="grid md:grid-cols-2 gap-5">
        {
          categories.map((c) => (
            <article class="card flex flex-col gap-5 hover:-translate-y-1 transition-transform">
              <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-4">
                  <span class="grid place-items-center size-14 rounded-2xl bg-brand-50 text-brand-900">
                    <Icon name={iconFor(c.slug)} size={28} />
                  </span>
                  <div>
                    <h2 class="font-display font-bold text-xl text-brand-950 leading-tight">
                      {c.title}
                    </h2>
                    <p class="text-sm text-ink-500">{c.subtitle}</p>
                  </div>
                </div>
                <span class="font-display text-3xl font-bold text-brand-900/15">
                  {c.code}
                </span>
              </div>

              <p class="text-sm text-ink-700 leading-relaxed text-pretty">
                {c.description}
              </p>

              <dl class="grid grid-cols-3 gap-3 text-center text-xs">
                <div class="rounded-xl bg-ink-50 p-3">
                  <dt class="text-ink-500 uppercase tracking-wider font-semibold">
                    Всего
                  </dt>
                  <dd class="font-display font-bold text-brand-900 text-lg mt-1">
                    {c.totalHours} ч
                  </dd>
                </div>
                <div class="rounded-xl bg-ink-50 p-3">
                  <dt class="text-ink-500 uppercase tracking-wider font-semibold">
                    Теория
                  </dt>
                  <dd class="font-display font-bold text-brand-900 text-lg mt-1">
                    {c.theoryHours} ч
                  </dd>
                </div>
                <div class="rounded-xl bg-ink-50 p-3">
                  <dt class="text-ink-500 uppercase tracking-wider font-semibold">
                    Практика
                  </dt>
                  <dd class="font-display font-bold text-brand-900 text-lg mt-1">
                    {c.practiceHours} ч
                  </dd>
                </div>
              </dl>

              <div class="flex items-center justify-between gap-3 pt-2 border-t border-ink-100">
                <span class="text-xs text-ink-500 inline-flex items-center gap-1.5">
                  <Icon name="calendar" size={14} class="text-brand-700" />
                  {c.duration}
                </span>
                <a
                  href={`/categories/${c.slug}/`}
                  class="btn btn-ghost text-sm py-2 px-4"
                >
                  Подробнее
                  <Icon name="arrow-right" size={14} />
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <div class="card bg-brand-50 border-brand-100 flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-6">
        <span class="grid place-items-center size-12 rounded-2xl bg-brand-900 text-accent-300 shrink-0">
          <Icon name="document" size={24} />
        </span>
        <div class="flex-1 space-y-1">
          <h3 class="font-display font-bold text-lg text-brand-950">
            Документы для поступления
          </h3>
          <p class="text-sm text-ink-700">
            Медицинская справка о допуске к управлению ТС · копия паспорта
            (1-я страница и прописка) · копия документа об образовании · 2
            фотографии 3×4 см.
          </p>
        </div>
        <a href="/contacts/#signup" class="btn btn-primary text-sm shrink-0">
          Записаться
        </a>
      </div>
    </div>
  </section>
</Layout>
