---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Placeholder from "../components/Placeholder.astro";
import Stat from "../components/Stat.astro";
import { site } from "../data/site";
import { categories } from "../data/categories";
import { faq } from "../data/faq";

const heroCategories = categories.slice(0, 3);
const yearsActive = new Date().getFullYear() - site.founded;

const advantages = [
  {
    icon: "shield" as const,
    title: "Официальная организация",
    text: "Мостовское РО ВОА работает с 1973 года и зарегистрировано в реестре образовательных организаций.",
  },
  {
    icon: "users" as const,
    title: "Опытные преподаватели",
    text: "Инструкторы со стажем 12–27 лет, квалификация подтверждена удостоверениями и дипломами.",
  },
  {
    icon: "pin" as const,
    title: "Два учебных адреса",
    text: "Учебные классы на ул. Красной 88 и ул. Кооперативной 28 — рядом с домом и работой.",
  },
  {
    icon: "wheel" as const,
    title: "Площадка по требованиям ГИБДД",
    text: "Учебные маршруты и автодром согласованы с подразделением ГИБДД.",
  },
  {
    icon: "graduation" as const,
    title: "Очно-заочная форма",
    text: "Учитесь в удобное время: теория — в классе и через интерактивную онлайн-систему.",
  },
  {
    icon: "heart" as const,
    title: "Первая помощь",
    text: "Курс первой помощи при ДТП преподаёт медицинская сестра с 35-летним стажем.",
  },
];

const process = [
  {
    step: "1",
    title: "Заявка и документы",
    text: "Звоните или приходите. Готовите: паспорт, мед.справку, документ об образовании, 2 фото 3×4.",
  },
  {
    step: "2",
    title: "Теория",
    text: "Изучаете ПДД, устройство автомобиля, безопасность и первую помощь в классе и онлайн.",
  },
  {
    step: "3",
    title: "Практика",
    text: "Отрабатываете навыки на площадке и по согласованным с ГИБДД учебным маршрутам.",
  },
  {
    step: "4",
    title: "Экзамены",
    text: "Сдаёте внутренний экзамен в школе, затем — государственный экзамен в ГИБДД.",
  },
];

const testimonials = [
  {
    name: "Анна К.",
    course: "Категория B",
    text: "Спасибо инструктору! Всё разложили по полочкам, экзамен сдала с первого раза. Особенно понравилась практика в городе.",
  },
  {
    name: "Денис П.",
    course: "Категория C",
    text: "Прошёл переподготовку с B на C — программа сжатая, но всё необходимое разобрали. Машина в хорошем состоянии, площадка как в ГИБДД.",
  },
  {
    name: "Сергей М.",
    course: "Категория A",
    text: "Учился на мотоцикл. Преподаватели грамотные, объясняют доступно. Площадка нормальная, можно отрабатывать фигуры спокойно.",
  },
];
---

<Layout>
  <section class="relative overflow-hidden bg-brand-950 text-white">
    <div class="absolute inset-0 grid-pattern opacity-10" aria-hidden="true"></div>
    <div
      class="absolute -top-32 -right-24 w-[42rem] h-[42rem] rounded-full bg-accent-400/20 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute -bottom-32 -left-24 w-[42rem] h-[42rem] rounded-full bg-brand-500/30 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative pt-12 pb-20 md:pt-16 md:pb-28 lg:pt-20 lg:pb-32">
      <div class="grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-7">
          <span class="eyebrow text-accent-300 before:bg-accent-400">
            {site.shortName} · с {site.founded} года
          </span>
          <h1 class="font-display font-bold text-balance text-4xl md:text-5xl lg:text-6xl xl:text-7xl leading-[1.02]">
            Уверенное вождение —
            <span class="text-accent-300">с первого занятия</span>
          </h1>
          <p class="text-lg md:text-xl text-white/80 max-w-xl leading-relaxed">
            Официальная автошкола Всероссийского общества автомобилистов в
            посёлке Мостовском. Готовим водителей категорий A, B, C и проводим
            переподготовку — уже более 50 лет.
          </p>

          <div class="flex flex-wrap gap-3 pt-2">
            <a href="/contacts/#signup" class="btn btn-primary">
              Записаться на обучение
              <Icon name="arrow-right" size={18} />
            </a>
            <a
              href={`tel:${site.phones[0].replace(/[^+\d]/g, "")}`}
              class="btn btn-ghost text-white border-white/20 hover:bg-white/10 hover:border-white/40"
            >
              <Icon name="phone" size={18} class="text-accent-400" />
              {site.phones[0]}
            </a>
          </div>

          <ul class="flex flex-wrap gap-x-6 gap-y-3 pt-4 text-sm text-white/75">
            <li class="flex items-center gap-2">
              <Icon name="check" size={16} class="text-accent-300" />
              Лицензированная организация
            </li>
            <li class="flex items-center gap-2">
              <Icon name="check" size={16} class="text-accent-300" />
              Очно-заочно
            </li>
            <li class="flex items-center gap-2">
              <Icon name="check" size={16} class="text-accent-300" />
              Площадка и город
            </li>
          </ul>
        </div>

        <div class="lg:col-span-5">
          <div class="relative">
            <Placeholder
              caption="Главный учебный класс автошколы ВОА на ул. Красной, 88"
              label="Hero фото"
              ratio="4/3"
              class="shadow-lift"
            />
            <div
              class="absolute -bottom-6 -left-6 card bg-white text-ink-900 max-w-[14rem] hidden md:block"
            >
              <div class="flex items-center gap-3">
                <span class="grid place-items-center size-10 rounded-full bg-accent-100 text-accent-600">
                  <Icon name="star" size={20} />
                </span>
                <div>
                  <p class="font-semibold text-sm">{yearsActive}+ лет опыта</p>
                  <p class="text-xs text-ink-500">Учим с 1973 года</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page space-y-10">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <SectionHeading
          eyebrow="Категории прав"
          title="Подготовка водителей любой категории"
          description="Полные программы профессиональной подготовки и быстрая переподготовка для тех, у кого уже есть права."
        />
        <a href="/categories/" class="btn btn-ghost text-sm shrink-0">
          Все категории
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          heroCategories.map((c) => (
            <a
              href={`/categories/${c.slug}/`}
              class="card group flex flex-col gap-5 hover:-translate-y-1 transition-transform"
            >
              <div class="flex items-center justify-between">
                <span class="grid place-items-center size-14 rounded-2xl bg-brand-50 text-brand-900 group-hover:bg-accent-100 group-hover:text-accent-600 transition-colors">
                  <Icon
                    name={
                      c.slug === "a"
                        ? "motorcycle"
                        : c.slug === "c"
                          ? "truck"
                          : "car"
                    }
                    size={28}
                  />
                </span>
                <span class="text-3xl font-display font-bold text-brand-900/15 group-hover:text-accent-300 transition-colors">
                  {c.code}
                </span>
              </div>
              <div class="space-y-2">
                <h3 class="text-xl font-display font-bold text-brand-950">
                  {c.title}
                </h3>
                <p class="text-sm text-ink-500">{c.subtitle}</p>
                <p class="text-sm text-ink-700 leading-relaxed">{c.description}</p>
              </div>
              <div class="flex items-center justify-between pt-2 border-t border-ink-100 text-sm">
                <span class="text-ink-500">
                  <strong class="text-brand-900">{c.totalHours}</strong> ч · {c.duration}
                </span>
                <span class="text-brand-900 font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                  Подробнее
                  <Icon name="arrow-right" size={14} />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-ink-50">
    <div class="container-page space-y-12">
      <SectionHeading
        eyebrow="Почему мы"
        title="6 причин выбрать Мостовское ВОА"
        description="Мы — официальное отделение всероссийской общественной организации, и за плечами у нас полвека работы."
      />
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          advantages.map((a) => (
            <div class="card flex gap-4">
              <span class="grid place-items-center size-12 rounded-xl bg-brand-900 text-accent-300 shrink-0">
                <Icon name={a.icon} size={24} />
              </span>
              <div class="space-y-1.5">
                <h3 class="font-display font-bold text-brand-950 text-lg">
                  {a.title}
                </h3>
                <p class="text-sm text-ink-700 leading-relaxed">{a.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-brand-950 text-white relative overflow-hidden">
    <div class="absolute inset-0 grid-pattern opacity-5" aria-hidden="true"></div>
    <div class="container-page relative space-y-10">
      <SectionHeading
        eyebrow="Цифры"
        title="50+ лет опыта в одной школе"
        align="center"
      />
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
        <Stat value={`${yearsActive}+`} label="Лет работы" description="С 1973 года готовим водителей" />
        <Stat value="6" label="Категорий" description="A, B, C и переподготовка" />
        <Stat value="4+" label="Преподавателя" description="Стаж до 27 лет" />
        <Stat value="2" label="Учебных адреса" description="Удобно добраться" />
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page space-y-12">
      <SectionHeading
        eyebrow="Как проходит обучение"
        title="От заявки до водительского удостоверения"
        description="Четыре понятных шага — мы сопровождаем вас на каждом этапе."
      />
      <ol class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          process.map((p) => (
            <li class="card relative pt-10">
              <span
                class="absolute -top-5 left-6 grid place-items-center size-12 rounded-2xl bg-accent-400 text-brand-950 font-display font-bold text-xl"
              >
                {p.step}
              </span>
              <h3 class="font-display font-bold text-lg text-brand-950">
                {p.title}
              </h3>
              <p class="mt-2 text-sm text-ink-700 leading-relaxed">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section bg-ink-50">
    <div class="container-page space-y-12">
      <SectionHeading
        eyebrow="Отзывы"
        title="Что говорят наши выпускники"
      />
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          testimonials.map((t) => (
            <figure class="card flex flex-col gap-4">
              <div class="flex gap-0.5 text-accent-400">
                {Array.from({ length: 5 }).map(() => (
                  <Icon name="star" size={18} />
                ))}
              </div>
              <blockquote class="text-ink-700 leading-relaxed text-pretty">
                «{t.text}»
              </blockquote>
              <figcaption class="flex items-center gap-3 mt-auto pt-4 border-t border-ink-100">
                <span class="grid place-items-center size-11 rounded-full bg-brand-900 text-white font-bold">
                  {t.name.charAt(0)}
                </span>
                <div>
                  <p class="font-semibold text-brand-950">{t.name}</p>
                  <p class="text-xs text-ink-500">{t.course}</p>
                </div>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="text-center text-xs text-ink-500 max-w-xl mx-auto">
        Отзывы из открытых источников и анкет выпускников. Имена сокращены по
        требованию закона о персональных данных.
      </p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5">
        <SectionHeading
          eyebrow="FAQ"
          title="Частые вопросы"
          description="Если ответа нет — позвоните или напишите, ответим в течение часа в рабочие часы."
        />
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/contacts/" class="btn btn-ghost text-sm">
            <Icon name="phone" size={16} />
            Контакты
          </a>
          <a href={`mailto:${site.emails[0]}`} class="btn btn-ghost text-sm">
            <Icon name="mail" size={16} />
            Написать
          </a>
        </div>
      </div>
      <div class="lg:col-span-7 space-y-3">
        {
          faq.slice(0, 6).map((item, i) => (
            <details
              class="card cursor-pointer group [&_summary::-webkit-details-marker]:hidden"
              open={i === 0}
            >
              <summary class="flex items-start justify-between gap-4 list-none">
                <h3 class="font-display font-semibold text-base md:text-lg text-brand-950 text-pretty">
                  {item.q}
                </h3>
                <span
                  class="grid place-items-center size-8 rounded-full bg-brand-50 text-brand-900 shrink-0 transition-transform group-open:rotate-180"
                >
                  <Icon name="chevron-down" size={16} />
                </span>
              </summary>
              <p class="mt-3 text-ink-700 text-sm md:text-base leading-relaxed">
                {item.a}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div
        class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand-900 via-brand-800 to-brand-700 text-white p-8 md:p-14 lg:p-16"
      >
        <div
          class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-accent-400/20 blur-3xl"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full bg-brand-400/30 blur-3xl"
          aria-hidden="true"
        >
        </div>

        <div class="relative grid lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7 space-y-4">
            <p class="eyebrow text-accent-300 before:bg-accent-400">
              Готовы начать?
            </p>
            <h2 class="font-display font-bold text-3xl md:text-5xl text-balance leading-tight">
              Запишитесь на обучение
              <br /> в Мостовское ВОА
            </h2>
            <p class="text-white/80 text-lg max-w-xl">
              Позвоните или приходите по адресу: ул. Кирова, 1 корп. Б. Поможем
              выбрать категорию и расскажем про следующий набор группы.
            </p>
          </div>
          <div class="lg:col-span-5 space-y-3">
            <a
              href={`tel:${site.phones[0].replace(/[^+\d]/g, "")}`}
              class="card flex items-center gap-4 text-ink-900 hover:bg-ink-50"
            >
              <span class="grid place-items-center size-12 rounded-xl bg-accent-100 text-accent-600">
                <Icon name="phone" size={24} />
              </span>
              <div>
                <p class="text-xs text-ink-500 uppercase tracking-wider font-semibold">
                  Телефон
                </p>
                <p class="font-display font-bold text-lg text-brand-950">
                  {site.phones[0]}
                </p>
              </div>
            </a>
            <a
              href={`mailto:${site.emails[0]}`}
              class="card flex items-center gap-4 text-ink-900 hover:bg-ink-50"
            >
              <span class="grid place-items-center size-12 rounded-xl bg-accent-100 text-accent-600">
                <Icon name="mail" size={24} />
              </span>
              <div>
                <p class="text-xs text-ink-500 uppercase tracking-wider font-semibold">
                  Email
                </p>
                <p class="font-display font-bold text-lg text-brand-950">
                  {site.emails[0]}
                </p>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
